{
  "name": "mercer-stellaria",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "railway:start": "DB_DIR=${RAILWAY_VOLUME_MOUNT_PATH:-/data}; mkdir -p \"$DB_DIR\"; if [ -f ./data/production.db ] && [ ! -f \"$DB_DIR/production.db\" ]; then cp ./data/production.db \"$DB_DIR/production.db\"; fi; export DATABASE_URL=file:${DB_DIR}/production.db; prisma db push && next start -p $PORT"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.6",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-auth": "^4.24.15",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
