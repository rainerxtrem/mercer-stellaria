generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  PUBLIC
  CLIENT
  COLLABORATOR
  ADMIN
}

enum PermissionResourceType {
  SPACE
  PAGE
  MODULE
  ACTION
  FEATURE
}

enum RouteMatchType {
  EXACT
  PREFIX
  REGEXP
}

enum ContractCategory {
  HEALTH
  THEFT_BURGLARY
  PROFESSIONAL
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum SignatureMethod {
  DRAWN_CANVAS
  CERTIFIED_CLICK
}

enum InvoiceStatus {
  PENDING
  PAID
  LATE
  CANCELED
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  WAITING_DETAILS
  APPROVED
  REJECTED
  PAID
}

enum SubscriptionRequestType {
  NEW_SUBSCRIPTION
  UPGRADE
}

enum SubscriptionRequestStatus {
  REQUESTED
  WAITING_MEETING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum NotificationType {
  CONTRACT
  CLAIM
  BILLING
  MESSAGE
  REQUEST
  SYSTEM
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  discordId     String?  @unique
  fullName      String
  firstName     String?
  lastName      String?
  avatarUrl     String?
  birthDate     DateTime?
  phone         String?
  citizenUniqueId String? @unique
  discordHandle String?
  profileCompleted  Boolean @default(false)
  riskQuestionnaire Json?
  riskScore         Int?
  riskLabel         String?
  isArchived        Boolean @default(false)
  archivedAt        DateTime?
  archivedById      String?
  role          UserRole @default(CLIENT)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  managedClients   User[]  @relation("ClientPortfolio")
  accountManager   User?   @relation("ClientPortfolio", fields: [accountManagerId], references: [id])
  accountManagerId String?

  clientContracts Contract[] @relation("ClientContracts")
  agentContracts  Contract[] @relation("AgentContracts")
  invoices        Invoice[]
  claims          Claim[]    @relation("ClientClaims")
  reviewedClaims  Claim[]    @relation("ClaimReviewer")
  claimMessages   ClaimMessage[]
  contactConversationState ContactConversationState?
  contactConversationArchives ContactConversationArchive[] @relation("ContactConversationArchiveClient")
  contactConversationArchivesClosed ContactConversationArchive[] @relation("ContactConversationArchiveCloser")
  sentContactMessages ContactMessage[] @relation("ContactSender")
  clientContactMessages ContactMessage[] @relation("ContactClient")
  subscriptionRequests         SubscriptionRequest[] @relation("SubscriptionClient")
  reviewedSubscriptionRequests SubscriptionRequest[] @relation("SubscriptionReviewer")
  appNotifications             AppNotification[]
  auditLogs                    AuditLog[] @relation("AuditActor")
  riskQuestionnaireHistoryAsClient RiskQuestionnaireHistory[] @relation("RiskHistoryClient")
  riskQuestionnaireHistoryAsActor  RiskQuestionnaireHistory[] @relation("RiskHistoryActor")
  createdDocumentTemplates     DocumentTemplate[] @relation("DocumentTemplateCreator")
  updatedDocumentTemplates     DocumentTemplate[] @relation("DocumentTemplateUpdater")
  generatedDocumentsCreated    GeneratedDocument[] @relation("GeneratedDocumentCreator")
  generatedDocumentsAsClient   GeneratedDocument[] @relation("GeneratedDocumentClient")
  userGrades                   UserGrade[] @relation("UserGrades")
  gradeAssignmentsMade         UserGrade[] @relation("GradeAssignmentActor")
}

model Grade {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  rank        Int
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userGrades   UserGrade[]
  permissions  GradePermission[]

  @@index([rank])
}

model UserGrade {
  userId       String
  gradeId      String
  assignedAt   DateTime @default(now())
  assignedById String?

  user       User   @relation("UserGrades", fields: [userId], references: [id], onDelete: Cascade)
  grade      Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  assignedBy User?  @relation("GradeAssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, gradeId])
  @@index([gradeId])
  @@index([assignedById, assignedAt])
}

model PermissionResource {
  id          String                 @id @default(uuid())
  key         String                 @unique
  label       String
  type        PermissionResourceType
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  gradePermissions GradePermission[]
  routeBindings    RoutePermissionBinding[]

  @@index([type])
}

model GradePermission {
  gradeId    String
  resourceId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  grade    Grade              @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  resource PermissionResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([gradeId, resourceId])
  @@index([resourceId])
}

model RoutePermissionBinding {
  id         String         @id @default(uuid())
  pattern    String
  matchType  RouteMatchType @default(PREFIX)
  resourceId String
  isEnabled  Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  resource PermissionResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([matchType, pattern, resourceId])
  @@index([isEnabled])
  @@index([matchType, pattern])
}

model SubscriptionRequest {
  id               String                    @id @default(uuid())
  requestNumber    String                    @unique
  clientId         String
  requestedFormula String
  requestedCategory ContractCategory
  currentFormula   String?
  type             SubscriptionRequestType
  reason           String?
  status           SubscriptionRequestStatus @default(REQUESTED)
  advisorValidated Boolean                   @default(false)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNotes      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  client     User  @relation("SubscriptionClient", fields: [clientId], references: [id])
  reviewedBy User? @relation("SubscriptionReviewer", fields: [reviewedById], references: [id])

  @@index([clientId, status])
  @@index([status])
}

model Contract {
  id              String           @id @default(uuid())
  contractNumber  String           @unique
  clientId        String
  agentId         String
  category        ContractCategory
  formulaName     String
  weeklyPremium   Float
  coverageSummary Json
  effectiveDate   DateTime
  expirationDate  DateTime?
  status          ContractStatus   @default(DRAFT)
  signatureMethod SignatureMethod?
  signatureData   String?
  signedAt        DateTime?
  pdfUrl          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  client   User      @relation("ClientContracts", fields: [clientId], references: [id])
  agent    User      @relation("AgentContracts", fields: [agentId], references: [id])
  invoices Invoice[]
  claims   Claim[]
  generatedDocuments GeneratedDocument[]

  @@index([clientId])
  @@index([agentId])
  @@index([status])
}

model Invoice {
  id               String        @id @default(uuid())
  invoiceNumber    String        @unique
  contractId       String
  clientId         String
  amount           Float
  dueDate          DateTime
  paidAt           DateTime?
  status           InvoiceStatus @default(PENDING)
  reminderSentAt   DateTime?
  discordWebhookId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  contract Contract @relation(fields: [contractId], references: [id])
  client   User     @relation(fields: [clientId], references: [id])

  @@index([clientId, status])
  @@index([contractId, dueDate])
}

model Claim {
  id              String      @id @default(uuid())
  claimNumber     String      @unique
  clientId        String
  contractId      String?
  incidentType    String
  description     String
  evidenceLink    String?
  lspdReportLink  String?
  incidentDate    DateTime
  declaredAt      DateTime    @default(now())
  status          ClaimStatus @default(SUBMITTED)
  requestedAmount Float?
  approvedAmount  Float?
  reviewedById    String?
  decisionNotes   String?
  clientLastReadAt DateTime?
  staffLastReadAt DateTime?
  reimbursedAt    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  client     User      @relation("ClientClaims", fields: [clientId], references: [id])
  contract   Contract? @relation(fields: [contractId], references: [id])
  reviewedBy User?     @relation("ClaimReviewer", fields: [reviewedById], references: [id])
  messages   ClaimMessage[]

  @@index([clientId, status])
  @@index([reviewedById])
}

model ContactConversationState {
  id              String   @id @default(uuid())
  clientId        String   @unique
  conversationId  String?
  clientLastReadAt DateTime?
  staffLastReadAt  DateTime?
  clientArchivedAt DateTime?
  staffArchivedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ContactConversationArchive {
  id             String   @id @default(uuid())
  clientId       String
  conversationId String   @unique
  openedAt       DateTime
  closedAt       DateTime?
  handledById    String?
  handledByName  String?
  closureReason  String?
  closedById     String?
  closedByRole   UserRole?
  closedByName   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client   User  @relation("ContactConversationArchiveClient", fields: [clientId], references: [id], onDelete: Cascade)
  closedBy User? @relation("ContactConversationArchiveCloser", fields: [closedById], references: [id], onDelete: SetNull)

  @@index([clientId, closedAt])
  @@index([closedById, createdAt])
}

model ClaimMessage {
  id           String   @id @default(uuid())
  claimId      String
  senderId     String
  senderRole   UserRole
  senderName   String
  body         String
  documentLink String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  claim   Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  sender  User  @relation(fields: [senderId], references: [id])

  @@index([claimId, createdAt])
  @@index([senderId])
}

model ContactMessage {
  id           String   @id @default(uuid())
  clientId     String
  conversationId String?
  senderId     String
  senderRole   UserRole
  senderName   String
  body         String
  documentLink String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client User @relation("ContactClient", fields: [clientId], references: [id], onDelete: Cascade)
  sender User @relation("ContactSender", fields: [senderId], references: [id])

  @@index([clientId, createdAt])
  @@index([conversationId, createdAt])
  @@index([senderId])
}

model AppNotification {
  id          String               @id @default(uuid())
  recipientId String
  type        NotificationType
  severity    NotificationSeverity @default(INFO)
  title       String
  body        String
  link        String?
  isRead      Boolean              @default(false)
  createdAt   DateTime             @default(now())
  readAt      DateTime?

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  UserRole?
  action     String
  entityType String
  entityId   String?
  summary    String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, createdAt])
  @@index([actorId, createdAt])
}

model RiskQuestionnaireHistory {
  id             String   @id @default(uuid())
  clientId       String
  actorId        String?
  oldAnswers     Json?
  newAnswers     Json
  oldScore       Int?
  newScore       Int
  oldLabel       String?
  newLabel       String
  createdAt      DateTime @default(now())

  client User  @relation("RiskHistoryClient", fields: [clientId], references: [id], onDelete: Cascade)
  actor  User? @relation("RiskHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([actorId, createdAt])
}

model DocumentTemplate {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  content     String
  isActive    Boolean  @default(true)
  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("DocumentTemplateCreator", fields: [createdById], references: [id])
  updatedBy User @relation("DocumentTemplateUpdater", fields: [updatedById], references: [id])
  generatedDocuments GeneratedDocument[]

  @@index([isActive, createdAt])
}

model GeneratedDocument {
  id              String          @id @default(uuid())
  documentNumber  String          @unique
  title           String
  templateId      String
  clientId        String?
  contractId      String?
  contentSnapshot String
  payloadSnapshot Json?
  signatureMethod SignatureMethod?
  signatureData   String?
  signedAt        DateTime?
  pdfUrl          String
  createdById     String
  createdAt       DateTime        @default(now())

  template  DocumentTemplate @relation(fields: [templateId], references: [id])
  creator   User             @relation("GeneratedDocumentCreator", fields: [createdById], references: [id])
  client    User?            @relation("GeneratedDocumentClient", fields: [clientId], references: [id])
  contract  Contract?        @relation(fields: [contractId], references: [id])

  @@index([templateId, createdAt])
  @@index([clientId, createdAt])
  @@index([createdById, createdAt])
}
